# ── Database ──────────────────────────────────────────────────────────────────
# Railway: set DB_HOST to the internal hostname of your Postgres service
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=scopetopay

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=roger@alsbuilders.com
ADMIN_PASSWORD=als2024!

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed CORS origins (your frontend URL)
CORS_ORIGINS=http://localhost:3000
# Used in invite/reset email links — set to your production frontend URL
FRONTEND_URL=http://localhost:3000

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Stripe ────────────────────────────────────────────────────────────────────
# 1. Create a product "ScopetoPay Pro" at https://dashboard.stripe.com/products
#    → Add a recurring price: $29.99/month, per unit
# 2. Copy the price ID (price_xxx) to STRIPE_PRICE_ID
# 3. Add a webhook at https://dashboard.stripe.com/webhooks
#    Endpoint URL: https://your-backend-domain/billing/webhook
#    Events: customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# If SMTP_HOST is not set, emails are logged to the console (good for local dev)
# Gmail: host=smtp.gmail.com, port=587, user=you@gmail.com, pass=App Password (not account password)
# SendGrid: host=smtp.sendgrid.net, port=587, user=apikey, pass=your-sendgrid-api-key
# Resend: host=smtp.resend.com, port=465, user=resend, pass=your-resend-api-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=ScopetoPay <noreply@yourdomain.com>

# ── Deployment checklist (Railway + Vercel) ───────────────────────────────────
# Backend (Railway):
#   1. Push this repo to GitHub
#   2. New project → Deploy from GitHub repo
#   3. Add a Postgres database service (Railway provides one)
#   4. Copy the Postgres connection vars into the backend service env
#   5. Set all vars above (JWT_SECRET, STRIPE_*, SMTP_*, ANTHROPIC_API_KEY, etc.)
#   6. Set FRONTEND_URL to your Vercel frontend URL
#   7. Set CORS_ORIGINS to your Vercel frontend URL
#
# Frontend (Vercel):
#   1. Import the frontend repo at vercel.com/new
#   2. Set NEXT_PUBLIC_API_URL to your Railway backend URL
#      e.g. https://als-docs-backend-production.up.railway.app
